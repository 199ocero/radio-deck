{
    "name": "jaocero/radio-deck",
    "description": "Turn Filament's radio and checkbox list into selectable cards with icons, titles, descriptions and colors.",
    "keywords": [
        "jaocero",
        "laravel",
        "radio-deck",
        "filamentphp",
        "filament-form",
        "filament-plugin"
    ],
    "homepage": "https://github.com/jaocero/radio-deck",
    "support": {
        "issues": "https://github.com/jaocero/radio-deck/issues",
        "source": "https://github.com/jaocero/radio-deck"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Jay-Are Ocero",
            "email": "199ocero@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/forms": "^4.0|^5.0",
        "illuminate/contracts": "^11.28|^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "filament/filament": "^4.0|^5.0",
        "laravel/pint": "^1.24",
        "nunomaduro/collision": "^8.1",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "JaOcero\\RadioDeck\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JaOcero\\RadioDeck\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JaOcero\\RadioDeck\\RadioDeckServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
